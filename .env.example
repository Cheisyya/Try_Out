# ---------------------------------------------------------------------------
# Contoh environment variable. Salin menjadi `.env.local` untuk pengembangan
# lokal, dan isikan nilainya pada dasbor hosting untuk produksi.
#
# Berkas `.env`, `.env.local`, dan turunannya TIDAK masuk git (lihat .gitignore).
# Tidak satu pun variabel di bawah ini berawalan NEXT_PUBLIC_, sehingga seluruh
# nilainya hanya hidup di server dan tidak pernah ikut terbundel ke browser.
#
# Setelah deploy, buka /admin/diagnosa untuk memastikan penyimpanan berfungsi.
# ---------------------------------------------------------------------------

# WAJIB DI PRODUKSI — kunci penanda tangan cookie sesi (minimal 32 karakter).
# Tanpa ini, aplikasi menolak menerbitkan sesi pada NODE_ENV=production,
# sehingga login admin maupun siswa akan gagal.
# Buat nilai acak, contoh:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# ---------------------------------------------------------------------------
# PENYIMPANAN DATA
#
# Kosong  -> memakai folder berkas (DATA_DIR, bawaannya `.data/`).
#            Cocok untuk pengembangan lokal atau hosting dengan disk permanen.
# Terisi  -> memakai database Postgres.
#            WAJIB pada hosting serverless seperti Vercel: di sana sistem
#            berkasnya hanya-baca dan hilang setiap permintaan selesai, jadi
#            tanpa database tidak ada satu pun perubahan yang tersimpan.
#
# Cocok dengan Vercel Postgres, Neon, maupun Supabase — ketiganya memberi satu
# connection string seperti di bawah. Tabelnya dibuat otomatis saat pertama
# kali dipakai; tidak ada langkah migrasi manual.
#
# Vercel Postgres mengisi POSTGRES_URL secara otomatis saat database
# dihubungkan ke project, jadi biasanya tidak perlu diisi tangan.
# ---------------------------------------------------------------------------
DATABASE_URL=
# postgres://pengguna:sandi@host:5432/nama_database?sslmode=require

# Opsional — lokasi folder data saat TIDAK memakai Postgres.
# Bawaan: folder `.data/` di dalam project. Arahkan ke volume yang dapat
# ditulis bila hosting Anda menyediakannya.
DATA_DIR=

# ---------------------------------------------------------------------------
# AKUN ADMINISTRATOR
#
# WAJIB DI PRODUKSI. Kredensial bawaan (admin@shc.id / adminkeren) tertulis di
# dalam kode sumber, jadi ia sengaja TIDAK berlaku saat NODE_ENV=production:
# selama kedua nilai di bawah kosong, panel admin tidak dapat dimasuki siapa
# pun. Password minimal 10 karakter.
#
# Periksa hasilnya di /admin/diagnosa setelah deploy.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Opsional: nama yang tampil pada panel admin (bawaan "admin shc").
ADMIN_NAMA=

# ---------------------------------------------------------------------------
# Opsional — jumlah koneksi database maksimal per instance (bawaan 8).
# Turunkan bila paket database Anda membatasi koneksi secara ketat.
# ---------------------------------------------------------------------------
DATABASE_POOL_MAX=
